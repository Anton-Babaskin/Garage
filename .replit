modules = ["nodejs-22", "postgresql-16"]
run = "npm install --omit=dev && ALLOW_FRAME=1 COOKIE_SAMESITE=None node server.js"

[deployment]
deploymentTarget = "vm"
build = ["npm", "install", "--omit=dev"]
run = ["node", "server.js"]

[[ports]]
localPort = 8080
externalPort = 80

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Garage"

[[workflows.workflow]]
name = "Garage"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "ALLOW_FRAME=1 COOKIE_SAMESITE=None node server.js"
waitForPort = 8080

[workflows.workflow.metadata]
outputType = "console"
